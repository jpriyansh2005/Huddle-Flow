# Copy to .env and adjust. Every value below is the default used when unset.

# SQLite database. Defaults to a huddleflow.db file inside the backend folder;
# uncomment to put it somewhere else.
# DATABASE_URL=sqlite:////absolute/path/to/huddleflow.db

# Where the Next.js app is served. Used to build invite links and for CORS.
FRONTEND_URL=http://localhost:3000

# Extra origins allowed to call the API, comma separated (optional).
EXTRA_CORS_ORIGINS=

# Pattern for allowed origins that are not known in advance (optional),
# e.g. Vercel preview deployments: https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Insert the default user and sample meetings when the database is empty.
SEED_ON_STARTUP=true

# Seconds an instant meeting stays open after the last person leaves.
EMPTY_ROOM_GRACE_SECONDS=60

# The built-in account (the assignment assumes one logged-in user).
DEFAULT_USER_NAME=Alex Morgan
DEFAULT_USER_EMAIL=alex.morgan@example.com
