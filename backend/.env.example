# Copy to .env and adjust. Every value below is the default used when unset.

# SQLite database. Defaults to a huddleflow.db file inside the backend folder;
# uncomment to put it somewhere else.
# DATABASE_URL=sqlite:////absolute/path/to/huddleflow.db

# Where the Next.js app is served. Used to build invite links and for CORS.
FRONTEND_URL=http://localhost:3000

# Extra origins allowed to call the API, comma separated (optional).
EXTRA_CORS_ORIGINS=

# Pattern for allowed origins that are not known in advance (optional),
# e.g. Vercel preview deployments: https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Give the demo account sample meetings when the database has none.
SEED_ON_STARTUP=true

# Seconds an instant meeting stays open after the last person leaves.
EMPTY_ROOM_GRACE_SECONDS=60

# --- Database (production) ---------------------------------------------------
# MySQL in production, e.g.
# DATABASE_URL=mysql+pymysql://user:password@host:3306/huddleflow?charset=utf8mb4
# Encrypt the connection (hosted MySQL needs this). Optionally point to the
# provider's CA certificate; otherwise the system's certificates are used.
DATABASE_SSL=false
# DATABASE_SSL_CA=/path/to/ca.pem
# Apply database migrations when the app starts.
MIGRATE_ON_STARTUP=true

# --- Accounts ------------------------------------------------------------------
# Send the session cookie only over HTTPS. Must be true in production.
COOKIE_SECURE=false
SESSION_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# The demo account owns the sample meetings; "Try the demo" signs in to it.
DEMO_ENABLED=true
DEMO_USER_NAME=Alex Morgan
DEMO_USER_EMAIL=demo@huddleflow.app

# --- AI meeting summaries (optional) -------------------------------------------
# Any OpenAI-compatible API. Groq by default: create a free key at
# https://console.groq.com/keys. Leave LLM_API_KEY empty to switch the feature off.
# Summarising sends the meeting's notes, transcript and chat to this provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# For OpenAI instead: LLM_BASE_URL= (empty) and an OpenAI model that supports
# structured outputs, e.g. a current GPT mini model.
LLM_TIMEOUT_SECONDS=60
# For reasoning models (gpt-oss, o-series); leave empty for models without it.
LLM_REASONING_EFFORT=low
LLM_MAX_INPUT_CHARS=16000
LLM_MAX_OUTPUT_TOKENS=2048
